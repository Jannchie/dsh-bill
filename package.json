{
  "name": "dsh-bill",
  "version": "0.13.1",
  "description": "DSH 费用统计插件:会话费用行 + 成本归因报告,llm-pricing 动态价格。 / DSH cost attribution and usage dashboard, priced by llm-pricing.",
  "type": "module",
  "license": "MIT",
  "author": "Jannchie",
  "homepage": "https://github.com/Jannchie/dsh-bill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/dsh-bill.git"
  },
  "bugs": {
    "url": "https://github.com/Jannchie/dsh-bill/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "usage",
    "token",
    "pricing",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "llm-pricing": "^0.12.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "docs:pair": "node scripts/i18n-pair.mjs",
    "check": "node --check lib/index.js && node --check lib/pricing.js && node --check lib/attribution.js && node --check lib/client.js && node --check lib/projection.js && node --check lib/hostkit.js",
    "test": "node tests/pricing.test.js && node tests/attribution.test.js && node tests/client.test.js && node tests/rollup.test.js && node tests/projection.test.js && node scripts/i18n-pair.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-atomic-write": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
